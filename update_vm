#!/bin/bash

# update_vm.sh - Build, stop the remote service, and deploy updated artifacts
#
# Usage: ./update_vm.sh <vm-host>
#
# Steps:
#   1. Build the backend and frontend locally
#   2. Stop emotion-ai on the VM
#   3. SCP the binary and frontend dist to the deployment directory
#
# Example:
#   ./update_vm.sh alpha.razuma.pro

set -e

VM_USER="alex"
VM_HOST=""
VM_DIR="/home/alex/emotionai"

usage() {
    echo "Usage: $0 <vm-host>"
    echo ""
    echo "Updates the EmotionAI deployment on a target VM."
    echo ""
    echo "Arguments:"
    echo "  vm-host    Hostname or IP of the target VM (e.g. alpha.razuma.pro)"
    echo ""
    echo "Example:"
    echo "  $0 alpha.razuma.pro"
    exit 1
}

if [ $# -lt 1 ]; then
    VM_HOST="45.132.179.232"
    echo "  No host specified; using default: ${VM_HOST}"
else
    VM_HOST="$1"
fi
VM_SSH="${VM_USER}@${VM_HOST}"

echo "============================================"
echo "  Updating EmotionAI on ${VM_HOST}"
echo "============================================"

# -------------------------------------------------------
# 0. ABI compatibility preflight
# -------------------------------------------------------
# The binary links against the local glibc and shared libraries. A newer
# build host (e.g. Ubuntu 26.04) produces a binary that cannot start on the
# Ubuntu 24.04 VM ("GLIBC_2.43 not found", "libspdlog.so.1.15: cannot open
# shared object file"), which looks like a dead API / failed upload. Refuse
# before stopping the remote service; deploy from CI (which builds on
# ubuntu-24.04) instead.
echo ""
echo "[0/4] Checking ABI compatibility with ${VM_HOST}..."
LOCAL_GLIBC="$(getconf GNU_LIBC_VERSION | awk '{print $2}')"
REMOTE_GLIBC="$(ssh "${VM_SSH}" "getconf GNU_LIBC_VERSION | awk '{print \$2}'")"
if [ -z "${LOCAL_GLIBC}" ] || [ -z "${REMOTE_GLIBC}" ]; then
    echo "ERROR: could not determine glibc versions (local='${LOCAL_GLIBC}', remote='${REMOTE_GLIBC}')"
    exit 1
fi
NEWEST_GLIBC="$(printf '%s\n%s\n' "${LOCAL_GLIBC}" "${REMOTE_GLIBC}" | sort -V | tail -1)"
if [ "${LOCAL_GLIBC}" != "${REMOTE_GLIBC}" ] && [ "${NEWEST_GLIBC}" = "${LOCAL_GLIBC}" ]; then
    echo "ERROR: local glibc ${LOCAL_GLIBC} is newer than the VM's ${REMOTE_GLIBC}."
    echo "       This binary would fail with status 127 (missing GLIBC / shared libs)."
    echo "       Deploy via CI instead:"
    echo "         gh workflow run ci.yml --repo Shurik12/EmotionAI --ref $(git branch --show-current) -f target=${VM_HOST}"
    exit 1
fi

# -------------------------------------------------------
# 1. Build locally
# -------------------------------------------------------
echo ""
echo "[1/4] Building..."
make build

# -------------------------------------------------------
# 2. Stop service on VM
# -------------------------------------------------------
echo ""
echo "[2/4] Stopping emotion-ai service on ${VM_HOST}..."
ssh "${VM_SSH}" "sudo service emotion-ai stop"

# -------------------------------------------------------
# 3. Deploy via scp
# -------------------------------------------------------
echo ""
echo "[3/4] Deploying files to ${VM_HOST}..."

# Binary
echo "  -> copying build/emotionai..."
scp build/emotionai "${VM_SSH}:${VM_DIR}/emotionai"

# Frontend dist  -> nginx root (frontend/build)
echo "  -> copying frontend/dist/* -> frontend/..."
ssh "${VM_SSH}" "mkdir -p ${VM_DIR}/frontend"
scp -r frontend/dist/* "${VM_SSH}:${VM_DIR}/frontend/"

# -------------------------------------------------------
# 4. Start service on VM
# -------------------------------------------------------
echo ""
echo "[4/4] Starting emotion-ai service on ${VM_HOST}..."
ssh "${VM_SSH}" "sudo service emotion-ai start"
echo "  -> Service started."

echo ""
echo "============================================"
echo "  Update complete!"
echo "============================================"
