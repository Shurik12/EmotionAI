@@ -85,6 +87,20 @@ EmotiEffLibRecognizerOnnx::EmotiEffLibRecognizerOnnx(const std::string& fullPipe
     // Define session options
     Ort::SessionOptions session_options;
 
+    // Optional GPU: the host app selects the execution provider via the
+    // EMOTIEFF_ONNX_DEVICE environment variable ("cuda" enables the CUDA
+    // execution provider). Unset/anything else keeps the default CPU provider;
+    // if CUDA is requested but unavailable we silently fall back to CPU.
+    const char* device = std::getenv("EMOTIEFF_ONNX_DEVICE");
+    if (device != nullptr && std::string(device) == "cuda") {
+        try {
+            OrtCUDAProviderOptions cuda_options{};
+            session_options.AppendExecutionProvider_CUDA(cuda_options);
+        } catch (const std::exception&) {
+            // CUDA provider not available in this build -> CPU
+        }
+    }
+
     // Load the ONNX model
     Ort::Session model(env_, fullPipelineModel.c_str(), session_options);
     models_.push_back(std::move(model));
