{
  "name": "emotionai-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor shell that packages the Razuma SPA as native Android and iOS apps",
  "type": "module",
  "scripts": {
    "build:web": "npm --prefix ../frontend run build:mobile",
    "sync": "npm run build:web && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "copy": "cap copy",
    "doctor": "cap doctor",
    "assets": "capacitor-assets generate"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.11",
    "@capacitor/core": "^7.6.11",
    "@capacitor/ios": "^7.6.11"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.11",
    "typescript": "^5.6.3"
  }
}
