# API base for the Capacitor mobile build (`npm run build:mobile`).
#
# It MUST be absolute and served over HTTPS:
#   * inside the app the bundle loads from a local WebView origin
#     (https://localhost on Android, capacitor://localhost on iOS), so the
#     web default "/api" would never reach the backend;
#   * Android blocks cleartext HTTP by default (API 28+).
#
# Change this one line to point the app at a different deployment.
VITE_API_URL=https://alpha.razuma.pro/api

# Optional shared API token. Must match `security.api_token` on the server.
# Leave empty while the backend has auth disabled; set it for a closed build.
# Shipped inside the bundle, so it is extractable — rotate it if it leaks.
VITE_API_TOKEN=
